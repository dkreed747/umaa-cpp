@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(umaa_cyclone_cpp)
find_dependency(CycloneDDS-CXX)
find_dependency(yaml-cpp CONFIG)
find_dependency(GeographicLib CONFIG)
find_dependency(fmt CONFIG)   # log4cxx's exported link interface references fmt::fmt
find_dependency(log4cxx CONFIG)

# uuid is a PRIVATE dependency of the shared library; only static consumers
# need to resolve it themselves.
if(NOT @BUILD_SHARED_LIBS@)
  find_dependency(PkgConfig)
  pkg_check_modules(uuid REQUIRED IMPORTED_TARGET GLOBAL uuid)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/umaa-cppTargets.cmake")

check_required_components(umaa-cpp)
