<!-- XML Configuration File Reference: -->
<!-- https://github.com/eclipse-cyclonedds/cyclonedds/blob/master/docs/manual/about_dds/qos_provider.rst -->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.arl.psu.edu/DDS-XML-QoS" xsi:schemaLocation="http://www.omg.org/spec/DDS-XML http://www.omg.org/spec/DDS-XML/20180501/dds-xml_qos_definitions.xsd">
    <qos_library name="UMAA_QoS_Library">
        <!-- A QoS Profile is a set of related QoS -->
        <qos_profile name="UMAA_Base_Profile">
            <!-- Domain Participant settings -->
            <domain_participant_qos>
            </domain_participant_qos>
            <!-- Topic settings -->
            <topic_qos>
            </topic_qos>
            <!-- Publisher settings -->
            <publisher_qos>
                <presentation>
                    <access_scope>TOPIC_PRESENTATION_QOS</access_scope>
                    <coherent_access>false</coherent_access>
                    <ordered_access>true</ordered_access>
                </presentation>
            </publisher_qos>
            <!-- Subscriber settings -->
            <subscriber_qos>
                <presentation>
                    <access_scope>TOPIC_PRESENTATION_QOS</access_scope>
                    <coherent_access>false</coherent_access>
                    <ordered_access>false</ordered_access>
                </presentation>
            </subscriber_qos>
            <!-- DataWriter settings -->
            <datawriter_qos>
                <destination_order>
                    <kind>BY_SOURCE_TIMESTAMP_DESTINATIONORDER_QOS</kind>
                </destination_order>
                <durability>
                    <kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
                </durability>
                <reliability>
                    <kind>RELIABLE_RELIABILITY_QOS</kind>
                    <max_blocking_time>
                        <sec>1</sec>
                        <nanosec>0</nanosec>
                    </max_blocking_time>
                </reliability>
                <history>
                    <kind>KEEP_LAST_HISTORY_QOS</kind>
                    <depth>1</depth>
                </history>
            </datawriter_qos>
            <!-- DataReader settings -->
            <datareader_qos>
                <destination_order>
                    <kind>BY_SOURCE_TIMESTAMP_DESTINATIONORDER_QOS</kind>
                </destination_order>
                <durability>
                    <!-- Specifies whether DDS will store and deliver previously published data to new/late-joining DataReaders.  -->
                    <!-- PERSISTENT_DURABILITY: Instances stored to disk-->
                    <!-- TRANSIENT_DURABILITY: Store nothing! We don't care!-->
                    <!-- Persistent helps insulate system from startup dependencies and can increase system tolerance to failure conditions. -->
                    <!-- Persistent durability incurs more cpu and disk utilization at runtime -->
                    <kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
                </durability>
                <reliability>
                    <kind>RELIABLE_RELIABILITY_QOS</kind>
                    <max_blocking_time>
                        <sec>1</sec>
                        <nanosec>0</nanosec>
                    </max_blocking_time>
                </reliability>
                <history>
                    <!-- Controls how much data to store and how stored data is managed for a DataWriter or DataReader. -->
                    <!-- KEEP_ALL: If you want strict reliability (TCP like behavior) -->
                    <!-- KEEP_LAST: Only gurantee the reliability of the last N (depth) values sent -->
                    <!-- Larger depth values will incur more memory and network utilization -->
                    <kind>KEEP_LAST_HISTORY_QOS</kind>
                    <depth>5</depth>
                </history>
            </datareader_qos>
        </qos_profile>
        <qos_profile name="UMAA_LargeCollections_Profile">
            <!-- Domain Participant settings -->
            <domain_participant_qos>
            </domain_participant_qos>
            <!-- Topic settings -->
            <topic_qos>
            </topic_qos>
            <!-- Publisher settings -->
            <publisher_qos>
                <presentation>
                    <access_scope>TOPIC_PRESENTATION_QOS</access_scope>
                    <coherent_access>false</coherent_access>
                    <ordered_access>false</ordered_access>
                </presentation>
            </publisher_qos>
            <!-- Subscriber settings -->
            <subscriber_qos>
                <presentation>
                    <access_scope>TOPIC_PRESENTATION_QOS</access_scope>
                    <coherent_access>false</coherent_access>
                    <ordered_access>true</ordered_access>
                </presentation>
            </subscriber_qos>
            <!-- DataWriter settings -->
            <datawriter_qos>
                <destination_order>
                    <kind>BY_SOURCE_TIMESTAMP_DESTINATIONORDER_QOS</kind>
                </destination_order>
                <durability>
                    <kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
                </durability>
                <reliability>
                    <kind>RELIABLE_RELIABILITY_QOS</kind>
                    <max_blocking_time>
                        <sec>1</sec>
                        <nanosec>0</nanosec>
                    </max_blocking_time>
                </reliability>
                <history>
                    <kind>KEEP_LAST_HISTORY_QOS</kind>
                    <depth>1</depth>
                </history>
            </datawriter_qos>
            <!-- DataReader settings -->
            <datareader_qos>
                <destination_order>
                    <kind>BY_SOURCE_TIMESTAMP_DESTINATIONORDER_QOS</kind>
                </destination_order>
                <durability>
                    <!-- Specifies whether Connext DDS will store and deliver previously published data to new/late-joining DataReaders.  -->
                    <!-- PERSISTENT_DURABILITY: Instances stored to disk-->
                    <!-- TRANSIENT_DURABILITY: Store nothing! We don't care!-->
                    <!-- Persistent helps insulate system from startup dependencies and can increase system tolerance to failure conditions. -->
                    <!-- Persistent durability incurs more cpu and disk utilization at runtime -->
                    <kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
                </durability>
                <reliability>
                    <kind>RELIABLE_RELIABILITY_QOS</kind>
                    <max_blocking_time>
                        <sec>1</sec>
                        <nanosec>0</nanosec>
                    </max_blocking_time>
                </reliability>
                <history>
                    <!-- Controls how much data to store and how stored data is managed for a DataWriter or DataReader. -->
                    <!-- KEEP_ALL: If you want strict reliability (TCP like behavior) -->
                    <!-- KEEP_LAST: Only gurantee the reliability of the last N (depth) values sent -->
                    <!-- Larger depth values will incur more memory and network utilization -->
                    <kind>KEEP_LAST_HISTORY_QOS</kind>
                    <depth>5</depth>
                </history>
            </datareader_qos>
        </qos_profile>
    </qos_library>
</dds>
